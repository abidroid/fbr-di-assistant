# Copy to .env and fill in real values. Never commit .env.

# --- Secrets and connection strings (Neon: use the DIRECT endpoint, no -pooler) ---
DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
TEST_DATABASE_URL=postgresql://user:password@ep-example-654321.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
JWT_SECRET_KEY=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-your-key-here
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Auth ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Files ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
SYNC_INGEST_MAX_PAGES=150
MAX_UNZIPPED_MB=200
MAX_ZIP_RATIO=100

# --- Extraction ---
MIN_TEXT_CHARS_PER_PAGE=50
CAPTION_MIN_IMAGE_RATIO=0.4
REPEATED_LINE_RATIO=0.5
PDF_MARGIN_RATIO=0.08
HEADING_SIZE_RATIO=1.1
SMALL_FONT_RATIO=0.8
CAPTION_CONCURRENCY=4
CAPTION_IMAGE_PX=1500

# --- Ingestion ---
EMBEDDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CHUNK_SIZE=500
CHUNK_OVERLAP=75
FIXED_CHUNK_SIZE=512
FIXED_CHUNK_OVERLAP=50
CHARS_PER_TOKEN=4
EMBED_BATCH_SIZE=16
QDRANT_COLLECTION=fbr_di_final
QDRANT_TIMEOUT_S=10
HNSW_M=16
HNSW_EF_CONSTRUCT=100

# --- Retrieval ---
CANDIDATES=30
TOP_K=6
REFUSAL_THRESHOLD=0.30

# --- LLM ---
LLM_MODEL=claude-sonnet-5-5
SMALL_MODEL=claude-haiku-5-5
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
# Leave unset to get a random canary per process.
# PROMPT_CANARY=CANARY-0123456789abcdef

# --- API ---
RATE_LIMIT=20/minute
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
HEALTH_TIMEOUT_S=3
